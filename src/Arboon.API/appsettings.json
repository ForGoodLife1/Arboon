{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=arboon_db;Username=postgres;Password=testDb"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!@#$",
    "Issuer": "Arboon",
    "Audience": "ArboonUsers",
    "ExpiryMinutes": 1440
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "Username": "your_email@gmail.com",
    "Password": "your_app_password",
    "FromEmail": "noreply@arboon.app",
    "FromName": "عَرْبُون"
  },
  "StripeSettings": {
    "SecretKey": "sk_test_placeholder",
    "PublishableKey": "pk_test_placeholder"
  },
  "AppSettings": {
    "BaseUrl": "https://arboon.app",
    "FrontendUrl": "https://arboon.app"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/arboon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}